# Personal game data - large binary saves, not source code.
/save games/
/melted_saves/

# Map tile/location data - not bundled per README, licensing.
/map_data/

# Extracted game-design data (e.g. modifier sources) pulled from the local
# EU5 install by tools/scan-modifier-sources.js - Paradox's own design/balance
# data, same never-commit treatment as map_data/'s raw files. Regenerate
# locally by pointing the tool at your own install; see tools/README.md.
/game_data/

# Intermediate input for tools/bake-home-hero.js (a per-location ownership
# snapshot derived from a chosen save) - not needed at runtime once
# assets/home-hero-map.jpg is baked and committed; regenerate on demand.
/assets/home-political-snapshot.json

# Recorder output - personal campaign data, regenerated by the recorder.
/llama-score-automatic-logging-machine/data/
/llama-score-automatic-logging-machine/data.backup-*/

# Local release/backend secrets.
.env
.env.local
.env.*.local

# Generated public browser config (Supabase URL + anon key) - kept out of
# source even though both values are public-safe. Netlify generates its own
# at build time; locally, `node scripts/write-config.js` regenerates it. See
# config.example.js. Lives at root (not /js/) so it dodges the immutable
# cache header /js/* gets.
/config.js

# Netlify local project metadata.
.netlify/
/dist/

# Desktop dashboard app - installed deps, packaged build output, and the
# vendored copy of js/ + the recorder (regenerated by prepare-vendor.js).
/llama-dashboard/node_modules/
/llama-dashboard/release/
/llama-dashboard/vendor/

# Internal dev notes - session diaries / infra notes with personal data,
# not meant for public view. Kept locally, just not shipped.
/HANDOFF.md
/docs/SUPABASE_NETLIFY_RELEASE.md

# Editor/OS cruft
.DS_Store
Thumbs.db
